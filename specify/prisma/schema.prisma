generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum Obligation {
  SHALL
  SHOULD
}

enum CertifierType {
  TUV_SUD
  BSI
  EU_AI_OFFICE
}

enum TagCategory {
  USE_CASE
  INDUSTRY
  MODEL_TYPE
  DEPLOYMENT_ENV
  RISK_TIER
  CUSTOM
}

enum NotificationType {
  COMMENT
  FORK
  MATCHING_PACKAGE
  REPLY
  STAR
  FOLLOW
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  org           String?
  bio           String?
  country       String?
  occupation    String?
  specialty     String?
  linkedinUrl   String?
  publications  String[]
  githubId      String?   @unique
  googleId      String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  packages        Package[]           @relation("AuthorPackages")
  stars           Star[]
  forks           Fork[]              @relation("ForkerForks")
  comments        Comment[]
  notifications   Notification[]
  preferences     UserPreference?
  certifications  Certification[]     @relation("GrantedBy")
  packageVersions PackageVersion[]    @relation("PublishedBy")
  followers       Follow[]            @relation("Following")
  following       Follow[]            @relation("Follower")
  contributions   PackageContributor[]
  vendorSubmissions Vendor[]           @relation("VendorSubmissions")
  riskVotes       RiskVote[]           @relation("RiskVotes")
  riskComments    RiskComment[]        @relation("RiskComments")
  riskSubmissions RiskSubmission[]     @relation("RiskSubmissions")
  promptQualities PromptQuality[]      @relation("PromptQualities")
  modelResults    ModelBenchmarkResult[] @relation("ModelResults")
  newsletterSub   NewsletterSubscriber? @relation("NewsletterSub")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Package {
  id              String    @id @default(cuid())
  slug            String    @unique
  authorId        String
  name            String
  description     String?
  license         String    @default("MIT")
  specifyVersion  String    @default("0.1")
  yamlUrl         String?
  currentVersion  String    @default("0.1.0")
  isPublished     Boolean   @default(false)
  viewCount       Int       @default(0)
  forkedFromId    String?
  aiModelUrls        String[]
  datasetUrls        String[]
  aiModels           Json      @default("[]")
  datasetRefs        Json      @default("[]")
  vendorList         Json      @default("[]")
  taxonomyData       Json      @default("{}")
  complianceTargets  String[]
  otherCompliance    String?
  isOpenSource       Boolean   @default(true)
  referenceUrls      String[]
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  author         User                 @relation("AuthorPackages", fields: [authorId], references: [id])
  forkedFrom     Package?             @relation("PackageForks", fields: [forkedFromId], references: [id])
  forks          Package[]            @relation("PackageForks")
  requirements   Requirement[]
  claims         PackageClaim[]       @relation("PackageClaims")
  comments       Comment[]
  stars          Star[]
  forkRecords    Fork[]               @relation("OriginalPackage")
  forkedRecords  Fork[]               @relation("ForkedPackage")
  certifications Certification[]
  versions       PackageVersion[]
  tags           Tag[]
  contributors   PackageContributor[]

  @@index([authorId])
  @@index([isPublished])
  @@index([createdAt])
}

model PackageContributor {
  id        String   @id @default(cuid())
  packageId String
  userId    String
  role      String   @default("contributor")
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([packageId, userId])
  @@index([packageId])
}

model PackageVersion {
  id            String   @id @default(cuid())
  packageId     String
  version       String
  yamlUrl       String
  changelog     String?
  diffSummary   String?  @db.Text
  publishedAt   DateTime @default(now())
  publishedById String

  package     Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  publishedBy User    @relation("PublishedBy", fields: [publishedById], references: [id])

  @@unique([packageId, version])
}

model Requirement {
  id          String     @id @default(cuid())
  packageId   String
  reqId       String
  title       String
  tags        String[]
  obligation  Obligation @default(SHALL)
  body        String?
  dependsOn   String[]
  order       Int        @default(0)

  media           Json      @default("[]")

  package         Package          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  subRequirements SubRequirement[]
  comments        Comment[]

  @@unique([packageId, reqId])
  @@index([packageId])
}

model SubRequirement {
  id            String     @id @default(cuid())
  requirementId String
  subId         String
  title         String
  obligation    Obligation @default(SHALL)
  body          String?
  order         Int        @default(0)

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, subId])
}

model Comment {
  id            String   @id @default(cuid())
  authorId      String
  packageId     String?
  requirementId String?
  body          String
  createdAt     DateTime @default(now())

  author      User         @relation(fields: [authorId], references: [id])
  package     Package?     @relation(fields: [packageId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([requirementId])
}

model Star {
  id        String   @id @default(cuid())
  userId    String
  packageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([userId, packageId])
}

model Fork {
  id                String   @id @default(cuid())
  originalPackageId String
  forkedPackageId   String
  forkerId          String
  createdAt         DateTime @default(now())

  originalPackage Package @relation("OriginalPackage", fields: [originalPackageId], references: [id])
  forkedPackage   Package @relation("ForkedPackage", fields: [forkedPackageId], references: [id])
  forker          User    @relation("ForkerForks", fields: [forkerId], references: [id])
}

model Certification {
  id          String        @id @default(cuid())
  packageId   String
  certifier   CertifierType
  grantedAt   DateTime      @default(now())
  grantedById String
  notes       String?

  package    Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  grantedBy  User    @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([packageId, certifier])
}

model Tag {
  id        String      @id @default(cuid())
  packageId String
  category  TagCategory
  value     String

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([category, value])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  read      Boolean          @default(false)
  packageId String?
  actorId   String?
  data      Json             @default("{}")
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model CardTemplate {
  id            String @id  // 'system-card' | 'model-card' | 'dataset-card' | 'provenance-record'
  downloadCount Int    @default(0)
}

model Vendor {
  id          String   @id @default(cuid())
  name        String
  website     String?
  description String?
  logoUrl     String?
  categories  String[]
  verified    Boolean  @default(false)
  submittedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submittedBy User? @relation("VendorSubmissions", fields: [submittedById], references: [id])

  @@index([verified])
  @@index([categories])
}

// ─── Risk Repository ───────────────────────────────────────────────────────────

model RiskVersion {
  id        String   @id @default(cuid())
  version   String   @unique  // e.g. "1.0"
  label     String?           // e.g. "Initial Release"
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  risks Risk[]
}

model Risk {
  id          String @id @default(cuid())
  riskNum     Int               // stable numeric ID within the list
  category    String            // Tier 1
  title       String
  description String @db.Text
  versionId   String

  version  RiskVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  votes    RiskVote[]
  comments RiskComment[]

  @@index([versionId])
  @@index([category])
  @@unique([versionId, riskNum])
}

model RiskVote {
  id        String   @id @default(cuid())
  riskId    String
  userId    String
  score     Int      // 0-10
  createdAt DateTime @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  user User @relation("RiskVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([riskId, userId])
  @@index([riskId])
}

model RiskComment {
  id        String   @id @default(cuid())
  riskId    String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  user User @relation("RiskComments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([riskId])
}

model RiskSubmission {
  id          String   @id @default(cuid())
  category    String
  title       String
  description String   @db.Text
  userId      String?
  status      String   @default("pending") // pending | accepted | rejected
  reviewNotes String?
  createdAt   DateTime @default(now())

  user User? @relation("RiskSubmissions", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  useCases        String[]
  industries      String[]
  certifiers      String[]
  notifyOnMatch   Boolean  @default(true)
  notifyOnComment Boolean  @default(true)
  notifyOnFork    Boolean  @default(true)
  notifyOnReply   Boolean  @default(true)
  notifyOnStar    Boolean  @default(true)
  notifyOnFollow  Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Self Audit: Prompt quality confirmations ──────────────────────────────────
model PromptQuality {
  id        String   @id @default(cuid())
  promptKey String   // "categoryId:::vectorName:::sampleIndex"
  userId    String
  createdAt DateTime @default(now())

  user User @relation("PromptQualities", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promptKey, userId])
  @@index([promptKey])
}

// ─── Self Audit: Model benchmark results ──────────────────────────────────────
model ModelBenchmarkResult {
  id           String   @id @default(cuid())
  modelName    String
  modelVersion String?
  provider     String?
  categoryId   String
  categoryName String
  totalSamples Int
  passCount    Int      // safe / refused correctly
  failCount    Int      // provided harmful content
  notes        String?  @db.Text
  submittedById String?
  createdAt    DateTime @default(now())

  submittedBy User? @relation("ModelResults", fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([modelName])
  @@index([categoryId])
  @@index([createdAt])
}

// ─── Newsletter subscriptions ──────────────────────────────────────────────────
model NewsletterSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  org         String?
  userId      String?  @unique
  confirmedAt DateTime?
  createdAt   DateTime @default(now())

  user User? @relation("NewsletterSub", fields: [userId], references: [id], onDelete: SetNull)
}

// ─── GSN: Claims, Requirements, Evidence ──────────────────────────────────────
// A Claim is a top-level assurance statement attached to a requirements package.
// Claims map to system abstraction levels and can reference legal obligations.
// Each Claim has Requirements (Architecture/Functional/Process) with Evidence.

model PackageClaim {
  id           String   @id @default(cuid())
  packageId    String
  text         String   @db.Text
  systemLevels String[] // Infrastructure | System | Model | Dataset | Software | Hardware
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  package      Package              @relation("PackageClaims", fields: [packageId], references: [id], onDelete: Cascade)
  obligations  ClaimLegalRef[]
  requirements PackageRequirement[]

  @@index([packageId])
}

// Legal obligation reference linked to a claim (e.g. "EU AI Act Article 9")
model ClaimLegalRef {
  id      String @id @default(cuid())
  claimId String
  source  String // e.g. "EU AI Act Article 9" or "ISO 42001 Clause 6.1"
  text    String @db.Text

  claim PackageClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  @@index([claimId])
}

// A requirement under a claim: Architecture, Functional, or Process
model PackageRequirement {
  id        String   @id @default(cuid())
  claimId   String
  type      String   // Architecture | Functional | Process
  text      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  claim    PackageClaim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence PackageEvidence[]

  @@index([claimId])
}

// Evidence that a requirement has been met
model PackageEvidence {
  id            String  @id @default(cuid())
  requirementId String
  title         String
  description   String? @db.Text
  url           String?
  createdAt     DateTime @default(now())

  requirement PackageRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  @@index([requirementId])
}
